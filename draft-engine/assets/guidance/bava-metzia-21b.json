{
  "ref": "Bava Metzia 21b",
  "source": "https://images.e-daf.com/DafImg.asp?ID=3067&size=2",
  "status": "Scan-derived Gemara boundaries; rendered layout requires validation. Sefaria expansions and variants are retained.",
  "settings": {
    "targetLineCounts": {
